# ============================================================================
# kwai pm kwai — Internal Management System
# Copy this file to .env and fill in real values. Never commit .env.
# ============================================================================

# --- Database (PostgreSQL) ---
# Local:     postgresql://postgres:postgres@localhost:5432/kwaipmkwai
# Supabase:  postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres
# Railway:   provided in the Railway Postgres plugin dashboard
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/kwaipmkwai"

# --- Auth ---
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-with: openssl rand -base64 32"
JWT_SECRET="generate-with: openssl rand -base64 32"

# --- WhatsApp Business Cloud API (Meta) ---
# Get these from developers.facebook.com -> your App -> WhatsApp -> API Setup
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_API_VERSION="v20.0"
# Any string you invent — used to verify the webhook handshake in Meta App Dashboard
WHATSAPP_VERIFY_TOKEN="kwai-pm-kwai-verify-2026"
# Meta App Dashboard -> Settings -> Basic -> App Secret.
# REQUIRED IN PRODUCTION: without it, inbound webhooks are rejected (fail-closed),
# because an unsigned webhook lets anyone inject fake client messages into your inbox.
WHATSAPP_APP_SECRET=""

# --- Email (Resend recommended) ---
RESEND_API_KEY=""
EMAIL_FROM="Kwai PM Kwai Travel and Tours Limited <booking@kwaipmkwaitravelandtours.com>"

# --- Email fallback (only used if RESEND_API_KEY is empty) ---
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""

# --- Cron protection (used by /api/cron/notifications) ---
CRON_SECRET="generate-with: openssl rand -base64 32"

# --- Exchange rate for multi-currency reporting ---
# Used to normalize TZS expenses against USD revenue when computing per-trip profit.
# Set this deliberately and update it periodically — a fixed rate keeps historical
# reports reproducible. Defaults to 2600 if unset.
TZS_PER_USD="2600"

# --- File storage for generated PDFs (itineraries, invoices) ---
# "supabase" | "s3" | "local"
# WARNING: Railway/Vercel filesystems are EPHEMERAL — "local" loses all PDFs on redeploy.
# Use supabase or s3 in production. If unset in production, uploads are skipped
# (PDFs still generate and download, they just aren't archived).
STORAGE_DRIVER="supabase"
STORAGE_SIGNED_URL_TTL="604800"

# If STORAGE_DRIVER=supabase (create a bucket named "documents" in the Supabase dashboard):
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="documents"

# If STORAGE_DRIVER=s3 (AWS S3, Cloudflare R2, Backblaze B2, MinIO):
S3_BUCKET=""
S3_REGION="us-east-1"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
# Set S3_ENDPOINT only for non-AWS providers (R2/B2/MinIO); leave blank for AWS.
S3_ENDPOINT=""

# --- Company details used on generated PDFs ---
COMPANY_BANK_DETAILS="Bank: CRDB Bank | Account Name: kwai pm kwai Ltd | Account No: 0150XXXXXXX | Swift: CORUTZTZ"
